---
import Base from '../../layouts/Base.astro';
import HomePage from '../../components/home/HomePage.astro';
import { copy } from '../../lib/copy';
import { ORG_ID, WEBSITE_ID, absolute } from '../../lib/site';

const t = copy.es;
const schema = [
  {
    '@type': 'WebPage',
    '@id': absolute('/es/#webpage'),
    url: absolute('/es/'),
    name: t.meta.title,
    description: t.meta.description,
    inLanguage: 'es',
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': ORG_ID },
  },
];
---

<Base
  lang="es"
  title={t.meta.title}
  description={t.meta.description}
  alternate={{ en: '/', es: '/es/' }}
  schema={schema}
  onHome
>
  <HomePage lang="es" />
</Base>
