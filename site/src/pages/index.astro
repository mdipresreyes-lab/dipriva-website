---
import Base from '../layouts/Base.astro';
import HomePage from '../components/home/HomePage.astro';
import { copy } from '../lib/copy';
import { ORG_ID, WEBSITE_ID, absolute } from '../lib/site';

const t = copy.en;
const schema = [
  {
    '@type': 'WebPage',
    '@id': absolute('/#webpage'),
    url: absolute('/'),
    name: t.meta.title,
    description: t.meta.description,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': ORG_ID },
  },
];
---

<Base
  lang="en"
  title={t.meta.title}
  description={t.meta.description}
  alternate={{ en: '/', es: '/es/' }}
  schema={schema}
  onHome
>
  <HomePage lang="en" />
</Base>
