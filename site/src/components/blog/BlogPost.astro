---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import ShareButtons from './ShareButtons.astro';
import { blogCopy, copy } from '../../lib/copy';
import type { Lang } from '../../lib/copy';
import { blogIndexPath, clusterLabel, isoDay, postPath } from '../../lib/blog';
import type { Post } from '../../lib/blog';
import { FOUNDER_ID, ORG_ID, absolute, formatDate, homePath, paths, readingMinutes } from '../../lib/site';

interface Props {
  post: Post;
  /** Posts in the same language, for the related list. */
  posts: Post[];
  lang: Lang;
  /** The post in the other language, when there is one. */
  counterpart?: Post;
}

const { post, posts, lang, counterpart } = Astro.props;
const b = blogCopy[lang];
const { Content, headings } = await render(post);
const d = post.data;
const url = absolute(postPath(lang, post.id));
const takeaways = d.takeaways ?? [];
const faq = d.faq ?? [];
// One entry per cited page: several quotes can come from the same URL.
const sources = [...new Map((d.sources ?? []).map((src) => [src.url, src])).values()];
const toc = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
  ...(faq.length ? [{ slug: 'faq', text: b.faq }] : []),
  ...(sources.length ? [{ slug: 'sources', text: b.sources }] : []),
];
const cta = b.ctaByCluster[d.cluster] ?? b.ctaByCluster['Startup Operations'];
// Generated for every post at build time by src/pages/og/[...slug].png.ts (1200 x 630).
const ogImage = lang === 'es' ? `/og/es/${post.id}.png` : `/og/${post.id}.png`;
const published = isoDay(d.date);
const updated = d.updated ? isoDay(d.updated) : published;
const dayOf = (iso: string) => new Date(`${iso}T12:00:00Z`);

// Title tag: seoTitle, or the title when there is none. " | Dipriva" is added only when the total stays under 60 characters.
const SUFFIX = ' | Dipriva';
const baseTitle = d.seoTitle ?? d.title;
const titleTag = baseTitle.length + SUFFIX.length < 60 ? `${baseTitle}${SUFFIX}` : baseTitle;

// Reciprocal hreflang only for a real translation. Without one, the language switch still
// leads somewhere useful: the other language's blog index.
const pair = counterpart
  ? { en: postPath('en', lang === 'en' ? post.id : counterpart.id), es: postPath('es', lang === 'es' ? post.id : counterpart.id) }
  : undefined;
const switchTo = pair ?? { en: lang === 'en' ? postPath('en', post.id) : blogIndexPath('en'), es: lang === 'es' ? postPath('es', post.id) : blogIndexPath('es') };

const related = posts
  .filter((p) => p.id !== post.id)
  .sort((a, z) => Number(z.data.cluster === d.cluster) - Number(a.data.cluster === d.cluster) || z.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);


const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: d.title,
    description: d.description,
    url,
    mainEntityOfPage: url,
    image: absolute(ogImage),
    datePublished: published,
    dateModified: updated,
    author: { '@id': FOUNDER_ID },
    publisher: { '@id': ORG_ID },
    articleSection: clusterLabel(lang, d.cluster),
    keywords: d.keyword,
    wordCount: d.words,
    inLanguage: lang,
    ...(sources.length
      ? {
          citation: sources.map((src) => ({
            '@type': 'CreativeWork',
            name: src.title,
            url: src.url,
            publisher: { '@type': 'Organization', name: src.publisher },
            datePublished: src.published,
          })),
        }
      : {}),
  },
  ...(faq.length
    ? [
        {
          '@type': 'FAQPage',
          '@id': `${url}#faq`,
          url,
          inLanguage: lang,
          about: { '@id': `${url}#article` },
          mainEntity: faq.map((item) => ({
            '@type': 'Question',
            name: item.q,
            acceptedAnswer: { '@type': 'Answer', text: item.a },
          })),
        },
      ]
    : []),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: b.home, item: absolute(homePath(lang)) },
      { '@type': 'ListItem', position: 2, name: b.title, item: absolute(blogIndexPath(lang)) },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---

<Base lang={lang} title={titleTag} description={d.description} alternate={pair} switchTo={switchTo} ogType="article" ogImage={ogImage} schema={schema}>
  <article>
    <header class="relative overflow-hidden border-b border-line">
      <div class="grid-paper grid-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="container-x relative pt-14 pb-14 lg:pt-20 lg:pb-16">
        <nav aria-label="Breadcrumb" class="text-sm text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href={homePath(lang)} class="hover:text-ink">{b.home}</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={blogIndexPath(lang)} class="hover:text-ink">{b.title}</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-ink">{clusterLabel(lang, d.cluster)}</li>
          </ol>
        </nav>
        <h1 class="display mt-8 max-w-[22ch] text-[clamp(2.1rem,4.6vw,3.9rem)]">{d.title}</h1>
        <p class="lede mt-6 max-w-[62ch]">{d.description}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-muted">
          <span class="flex items-center gap-3">
            <span class="grid size-9 place-content-center rounded-full bg-brand font-display text-on-brand" aria-hidden="true">M</span>
            <span>
              {b.by} <a href={paths.founder[lang]} class="font-semibold text-ink hover:underline">{d.author}</a>
            </span>
          </span>
          <span>
            {b.publishedOn} <time datetime={published}>{formatDate(d.date, lang) ?? b.undated}</time>
          </span>
          <span>{readingMinutes(d.words)} {b.minRead}</span>
        </div>
        <div class="mt-6">
          <ShareButtons url={url} title={d.title} labels={b.share} caption />
        </div>
      </div>
    </header>

    <div class="container-x grid gap-12 py-14 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-16 xl:grid-cols-[240px_minmax(0,720px)_1fr]">
      <aside class="hidden lg:block">
        {
          toc.length > 1 && (
            <nav class="toc sticky top-28" aria-label={b.onThisPage}>
              <p class="eyebrow">{b.onThisPage}</p>
              <ol class="mt-4 space-y-1 border-l border-line">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="relative -ml-px block border-l border-transparent py-1.5 pl-4 text-sm leading-snug text-muted transition-colors before:absolute before:top-0 before:-left-px before:h-full before:w-px hover:text-ink"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>

      <div class="min-w-0">
        {
          takeaways.length > 0 && (
            <aside class="card mb-12 p-6 sm:p-8" aria-labelledby="takeaways-title">
              <h2 id="takeaways-title" class="eyebrow">{b.takeaways}</h2>
              <ul class="mt-5 space-y-4">
                {takeaways.map((item) => (
                  <li class="flex items-start gap-3 leading-relaxed">
                    <Icon name="check" size={18} class="mt-1 shrink-0" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        <div class="prose-dipriva">
          <Content />
        </div>

        {
          faq.length > 0 && (
            <section id="faq" class="mt-16 scroll-mt-28 border-t border-line pt-10" aria-labelledby="faq-title">
              <h2 id="faq-title" class="h3 !text-[1.9rem]">{b.faq}</h2>
              <div class="mt-6 divide-y divide-line">
                {faq.map((item) => (
                  <div class="py-6">
                    <h3 class="font-display text-[1.2rem] leading-snug font-semibold">{item.q}</h3>
                    <p class="mt-3 leading-relaxed text-muted">{item.a}</p>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {
          sources.length > 0 && (
            <section id="sources" class="mt-14 scroll-mt-28 border-t border-line pt-10" aria-labelledby="sources-title">
              <h2 id="sources-title" class="h3 !text-[1.9rem]">{b.sources}</h2>
              <ol class="mt-6 list-decimal space-y-4 pl-6 text-[0.95rem] leading-relaxed marker:text-muted">
                {sources.map((src) => (
                  <li>
                    <a href={src.url} rel="noopener noreferrer" target="_blank" class="font-semibold underline underline-offset-2 hover:no-underline">
                      {src.title}
                    </a>
                    <span class="block text-muted">
                      {src.publisher}. {b.publishedOn} <time datetime={src.published}>{formatDate(dayOf(src.published), lang)}</time>. {b.retrievedOn}{' '}
                      <time datetime={src.retrieved}>{formatDate(dayOf(src.retrieved), lang)}</time>.
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <aside class="band relative mt-16 overflow-hidden rounded-[26px] p-8 sm:p-10" aria-label={cta.cta}>
          <div class="grid-paper grid-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>
          <div class="relative">
            <p class="eyebrow">{clusterLabel(lang, d.cluster)}</p>
            <p class="mt-4 font-display text-[clamp(1.5rem,2.6vw,2rem)] leading-tight font-semibold">{cta.title}</p>
            <p class="mt-3 max-w-[52ch] leading-relaxed text-muted">{cta.body}</p>
            <a href={cta.href} class="btn btn-primary mt-7">
              {cta.cta}
              <Icon name="arrow" size={18} class="arrow" />
            </a>
          </div>
        </aside>

        <div class="mt-12 flex flex-col gap-6 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            <span class="grid size-12 place-content-center rounded-full bg-brand font-display text-xl text-on-brand" aria-hidden="true">M</span>
            <div>
              <p class="font-semibold">{d.author}</p>
              <p class="text-sm text-muted">{copy[lang].about.role}</p>
            </div>
          </div>
          <ShareButtons url={url} title={d.title} labels={b.share} />
        </div>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="bg-surface py-16 lg:py-20" aria-labelledby="related-title">
        <div class="container-x">
          <div class="flex items-end justify-between gap-6">
            <h2 id="related-title" class="h3 !text-[1.9rem]">
              {b.related}
            </h2>
            <a href={blogIndexPath(lang)} class="link-arrow text-sm">
              {b.back}
              <Icon name="arrow" size={15} class="arrow" />
            </a>
          </div>
          <div class="mt-8 grid gap-4 md:grid-cols-3">
            {related.map((p) => (
              <article class="card spotlight group flex flex-col p-6">
                <span class="w-fit rounded-full border border-line px-3 py-1 text-xs font-semibold text-muted">{clusterLabel(lang, p.data.cluster)}</span>
                <h3 class="mt-5 font-display text-lg leading-snug font-semibold">
                  <a href={postPath(lang, p.id)} class="after:absolute after:inset-0">
                    {p.data.title}
                  </a>
                </h3>
                <p class="mt-auto pt-6 text-sm text-muted">{formatDate(p.data.date, lang) ?? b.undated}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<script>
  // Highlight the section being read in the table of contents.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const targets = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => Boolean(el));
  if (targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        links.forEach((a) => a.setAttribute('aria-current', String(a.hash.slice(1) === visible.target.id)));
      },
      { rootMargin: '-15% 0px -70% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }

  document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((button) =>
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.url ?? location.href);
        const label = button.textContent;
        button.textContent = button.dataset.done ?? label;
        window.setTimeout(() => (button.textContent = label), 1800);
      } catch {
        /* clipboard can be blocked; the URL is still in the address bar */
      }
    }),
  );
</script>
