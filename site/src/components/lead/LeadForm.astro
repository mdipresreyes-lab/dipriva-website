---
/**
 * The download form. Its payload matches what the dipriva-leads Worker
 * validates (worker/leads/src/validate.ts in dipriva-social): magnet, language,
 * name, email, business, size, needs, otherText, insightsOptin, source,
 * website (honeypot) and turnstileToken. Change both sides together.
 */
import Icon from '../Icon.astro';
import type { Lang } from '../../lib/copy';
import { CONTACT_EMAIL, IS_PRODUCTION, paths } from '../../lib/site';
import { LEADS_ENDPOINT, TURNSTILE_SITE_KEY, leadForm, type Magnet } from '../../lib/magnets';

interface Props {
  magnet: Magnet;
  lang: Lang;
}

const { magnet, lang } = Astro.props;
const other: Lang = lang === 'en' ? 'es' : 'en';
const serviceLine = leadForm.magnets[magnet.id].serviceLine;

// The page's own service line is listed first.
const groups = [...leadForm.groups].sort((a, b) => Number(b.id === serviceLine) - Number(a.id === serviceLine));

const ui = {
  en: {
    step: 'Step',
    of: 'of 2',
    needsHeading: 'What is slowing the business down?',
    otherPlaceholder: 'Tell us in one line',
    next: 'Next',
    back: 'Back',
    pickOne: 'Pick at least one, or tell us in one line.',
    name: 'Name',
    email: 'Email',
    business: 'Business name',
    size: 'Team size (optional)',
    sizeNone: 'Choose one',
    sizeLabels: ['1 to 9', '10 to 50', '51 to 500', '500+'],
    privacy: 'Privacy policy',
    submit: 'Send me the download',
    sending: 'Sending',
    spam: 'The spam check did not pass. Try again.',
    failed: `We could not send your request. Try again, or email ${CONTACT_EMAIL}.`,
    required: 'Fill in your name, a valid email and your business name.',
    doneHeading: 'Your download is ready.',
    otherLang: 'Spanish version',
    schedule: 'Prefer to talk now? Schedule a consultation.',
    noscript: `This form needs JavaScript. Email ${CONTACT_EMAIL} and Manuel will send the download.`,
    dryRun: 'QA build: this request was checked but not sent.',
  },
  es: {
    step: 'Paso',
    of: 'de 2',
    needsHeading: '¿Qué está frenando su negocio?',
    otherPlaceholder: 'Cuéntenos en una línea',
    next: 'Siguiente',
    back: 'Atrás',
    pickOne: 'Elija al menos una opción o cuéntenos en una línea.',
    name: 'Nombre',
    email: 'Correo electrónico',
    business: 'Nombre del negocio',
    size: 'Tamaño del equipo (opcional)',
    sizeNone: 'Elija una opción',
    sizeLabels: ['1 a 9', '10 a 50', '51 a 500', 'Más de 500'],
    privacy: 'Política de privacidad',
    submit: 'Envíenme la descarga',
    sending: 'Enviando',
    spam: 'La verificación contra spam no se completó. Inténtelo de nuevo.',
    failed: `No pudimos enviar su solicitud. Inténtelo de nuevo o escriba a ${CONTACT_EMAIL}.`,
    required: 'Escriba su nombre, un correo válido y el nombre de su negocio.',
    doneHeading: 'Su descarga está lista.',
    otherLang: 'Versión en inglés',
    schedule: '¿Prefiere hablar ahora? Agende una consulta.',
    noscript: `Este formulario necesita JavaScript. Escriba a ${CONTACT_EMAIL} y Manuel le enviará la descarga.`,
    dryRun: 'Versión QA: la solicitud se verificó pero no se envió.',
  },
}[lang];

const doneBody =
  lang === 'en'
    ? `Manuel reads every request and replies within ${leadForm.replyBusinessDays} business days with one suggestion based on your picks.`
    : `Manuel lee cada solicitud y responde en un plazo de ${leadForm.replyBusinessDays} días hábiles con una sugerencia basada en sus respuestas.`;

// Download links are written into the page only after a successful request.
const files = JSON.stringify(
  magnet.files.map((f) => ({ label: f.label[lang], href: f.href[lang], otherLabel: f.label[other], otherHref: f.href[other] })),
);
const messages = JSON.stringify({ pickOne: ui.pickOne, required: ui.required, spam: ui.spam, failed: ui.failed, sending: ui.sending, submit: ui.submit });
const id = `lead-${magnet.id}`;
---

<div
  class="lead-form"
  data-lead-form
  data-magnet={magnet.id}
  data-lang={lang}
  data-endpoint={LEADS_ENDPOINT}
  data-sitekey={TURNSTILE_SITE_KEY}
  data-files={files}
  data-messages={messages}
>
  <noscript>
    <p class="rounded-2xl border border-line bg-surface p-4 text-sm leading-relaxed">{ui.noscript}</p>
  </noscript>

  <form novalidate class="js-only space-y-6" aria-labelledby={`${id}-heading`}>
    <div class="flex items-center gap-3" aria-hidden="true">
      <span class="h-1 flex-1 rounded-full bg-brand"></span>
      <span class="step-bar h-1 flex-1 rounded-full bg-line"></span>
    </div>

    <fieldset data-step="1" class="space-y-6">
      <legend class="w-full">
        <span class="eyebrow block">{ui.step} <span data-step-num>1</span> {ui.of}</span>
        <span class="mt-3 block font-display text-[1.45rem] leading-snug font-semibold">{ui.needsHeading}</span>
      </legend>
      <p class="text-sm leading-relaxed text-muted">{leadForm.copy.helper[lang]}</p>

      {
        groups.map((group) => (
          <div class="space-y-2.5">
            <p class="text-sm font-semibold">{group.label[lang]}</p>
            {leadForm.options
              .filter((option) => option.group === group.id)
              .map((option) => (
                <label class="pick">
                  <input type="checkbox" name="needs" value={option.id} />
                  <span>{option.label[lang]}</span>
                </label>
              ))}
          </div>
        ))
      }

      <div class="space-y-2.5">
        <label class="pick">
          <input type="checkbox" name="otherOpen" data-other-toggle />
          <span>{leadForm.otherLabel[lang]}</span>
        </label>
        <div data-other-wrap hidden>
          <input
            type="text"
            name="otherText"
            maxlength={leadForm.otherMaxChars}
            placeholder={ui.otherPlaceholder}
            aria-label={leadForm.otherLabel[lang]}
            class="field"
          />
          <p class="mt-1 text-right text-xs text-muted"><span data-other-count>0</span>/{leadForm.otherMaxChars}</p>
        </div>
      </div>

      <p class="form-error" role="alert" data-error></p>
      <button type="button" class="btn btn-primary" data-next>
        {ui.next}
        <Icon name="arrow" size={18} class="arrow" />
      </button>
    </fieldset>

    <fieldset data-step="2" class="space-y-5" hidden>
      <legend class="eyebrow">{ui.step} 2 {ui.of}</legend>
      <label class="block space-y-2">
        <span class="text-sm font-medium">{ui.name}</span>
        <input type="text" name="name" autocomplete="name" required maxlength="100" class="field" />
      </label>
      <label class="block space-y-2">
        <span class="text-sm font-medium">{ui.email}</span>
        <input type="email" name="email" autocomplete="email" required maxlength="320" class="field" />
      </label>
      <label class="block space-y-2">
        <span class="text-sm font-medium">{ui.business}</span>
        <input type="text" name="business" autocomplete="organization" required maxlength="120" class="field" />
      </label>
      <label class="block space-y-2">
        <span class="text-sm font-medium">{ui.size}</span>
        <select name="size" class="field">
          <option value="">{ui.sizeNone}</option>
          {leadForm.sizes.map((value, i) => <option value={value}>{ui.sizeLabels[i]}</option>)}
        </select>
      </label>

      <!-- Hidden from people. Bots that fill it are dropped by the Worker. -->
      <div aria-hidden="true" class="absolute -left-[10000px] h-px w-px overflow-hidden">
        <label>
          Website
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <label class="pick">
        <input type="checkbox" name="insightsOptin" />
        <span class="text-sm">{leadForm.copy.insightsConsent[lang]}</span>
      </label>

      <p class="text-xs leading-relaxed text-muted">
        {leadForm.copy.notice[lang]}{' '}
        <a href={paths.privacy[lang]} class="underline underline-offset-2 hover:text-ink">{ui.privacy}</a>
      </p>

      <div data-turnstile class="min-h-[65px]"></div>

      <p class="form-error" role="alert" data-error></p>

      <div class="flex items-center gap-5">
        <button type="button" class="font-medium text-muted hover:text-ink" data-back>{ui.back}</button>
        <button type="submit" class="btn btn-primary" data-submit>{ui.submit}</button>
      </div>
    </fieldset>
  </form>

  <div class="space-y-5" data-done hidden role="status" tabindex="-1">
    <p class="flex items-center gap-3 font-display text-[1.6rem] font-semibold leading-tight">
      <span class="grid size-9 shrink-0 place-content-center rounded-full bg-brand text-on-brand"><Icon name="check" size={18} /></span>
      {ui.doneHeading}
    </p>
    <div class="flex flex-wrap gap-3" data-done-files></div>
    <p class="text-sm text-muted">{ui.otherLang}: <span data-done-other></span></p>
    <p class="leading-relaxed">{doneBody}</p>
    {!IS_PRODUCTION && <p class="text-xs font-semibold text-muted" data-dry-run hidden>{ui.dryRun}</p>}
    <a href={paths.schedule[lang]} class="link-arrow">
      {ui.schedule}
      <Icon name="arrow" size={16} class="arrow" />
    </a>
  </div>
</div>

<style>
  .lead-form :global(.pick) {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    cursor: pointer;
    line-height: 1.45;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .lead-form :global(.pick:hover) {
    border-color: var(--line-strong);
  }
  .lead-form :global(.pick:has(input:checked)) {
    border-color: var(--ink);
    background: var(--surface);
  }
  .lead-form :global(.pick:has(input:focus-visible)) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .lead-form :global(.pick input) {
    margin-top: 3px;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    accent-color: var(--brand);
  }
  .lead-form :global(.field) {
    width: 100%;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    padding: 12px 14px;
    font-size: 1rem;
  }
  .lead-form :global(.field:focus) {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
    border-color: transparent;
  }
  .lead-form :global(.form-error:empty) {
    display: none;
  }
  .lead-form :global(.form-error) {
    font-size: 0.9rem;
    font-weight: 600;
    color: #9b2c2c;
  }
  :global([data-theme='dark']) .lead-form :global(.form-error) {
    color: #f4a7a7;
  }
  .lead-form[data-step='2'] .step-bar {
    background: var(--brand);
  }
  :global(html:not(.js)) .js-only {
    display: none;
  }
</style>

<script>
  import { initLeadForms } from '../../scripts/lead-form';
  initLeadForms();
</script>
