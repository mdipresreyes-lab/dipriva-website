---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import { copy, type Lang } from '../../lib/copy';
import { company } from '../../lib/company';
import { services, servicePath } from '../../lib/services';
import { westMichiganPath } from '../../lib/westMichigan';
import { CONTACT_EMAIL, LINKEDIN_COMPANY, ORG_ID, WEBSITE_ID, absolute, homePath, paths, schedulePath } from '../../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = company[lang];
const t = copy[lang];
const url = absolute(paths.about[lang]);
const show = (fig: { to: number; prefix: string; suffix: string }) => `${fig.prefix}${fig.to.toLocaleString('en-US')}${fig.suffix}`;

const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${url}#webpage`,
    url,
    name: c.meta.title,
    description: c.meta.description,
    inLanguage: lang,
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': ORG_ID },
    mainEntity: { '@id': ORG_ID },
    abstract: c.inShort,
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    inLanguage: lang,
    isPartOf: { '@id': `${url}#webpage` },
    mainEntity: c.faq.items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: c.crumbs.home, item: absolute(homePath(lang)) },
      { '@type': 'ListItem', position: 2, name: c.crumbs.about, item: url },
    ],
  },
];
---

<Base
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  alternate={{ en: paths.about.en, es: paths.about.es }}
  schema={schema}
>
  <section class="relative overflow-hidden border-b border-line" aria-labelledby="about-title">
    <div class="grid-paper grid-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative pt-12 pb-16 lg:pt-16 lg:pb-20">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={homePath(lang)} class="hover:text-ink">{c.crumbs.home}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{c.crumbs.about}</li>
        </ol>
      </nav>
      <p class="eyebrow mt-8">{c.eyebrow}</p>
      <h1 id="about-title" class="display mt-5 max-w-[24ch] text-[clamp(2.2rem,4.6vw,3.9rem)]">{c.h1}</h1>
      <p class="lede mt-6 max-w-[60ch]">{c.sub}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={schedulePath(lang)} class="btn btn-primary">
          {c.cta.button}
          <Icon name="arrow" size={18} class="arrow" />
        </a>
        <a href={paths.founder[lang]} class="btn btn-ghost">{c.who.cta}</a>
      </div>
    </div>
  </section>

  <section class="py-14 lg:py-16" aria-labelledby="about-summary">
    <div class="container-x">
      <div class="card grid gap-6 p-7 sm:p-9 lg:grid-cols-[180px_1fr]">
        <h2 id="about-summary" class="eyebrow pt-1">{c.inShortLabel}</h2>
        <p class="text-[1.12rem] leading-relaxed">{c.inShort}</p>
      </div>
    </div>
  </section>

  <section class="pb-20 lg:pb-28" aria-labelledby="about-who">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="section-label reveal"><span class="num">01</span>{c.who.label}</p>
        <h2 id="about-who" class="h2 reveal mt-6 max-w-[22ch]">{c.who.h2}</h2>
        <div class="mt-8 space-y-5">
          {c.who.body.map((para) => <p class="lede reveal">{para}</p>)}
        </div>
        <a href={paths.founder[lang]} class="link-arrow reveal mt-8">
          {c.who.cta}
          <Icon name="arrow" size={15} class="arrow" />
        </a>
      </div>
      <div class="lg:col-span-5 lg:pt-14">
        <div class="card reveal p-7 sm:p-8">
          <h3 class="eyebrow">{c.facts.label}</h3>
          <dl class="mt-5 divide-y divide-line">
            {
              c.facts.rows.map((row) => (
                <div class="grid gap-1 py-4 first:pt-0 last:pb-0 sm:grid-cols-[130px_1fr] sm:gap-4">
                  <dt class="text-sm font-semibold">{row.term}</dt>
                  <dd class="text-sm leading-relaxed text-muted">{row.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-5 text-sm">
            <a href={`mailto:${CONTACT_EMAIL}`} class="inline-flex items-center gap-2 text-muted hover:text-ink">
              <Icon name="mail" size={16} />
              {CONTACT_EMAIL}
            </a>
            <a href={LINKEDIN_COMPANY} rel="me noopener" class="inline-flex items-center gap-2 text-muted hover:text-ink">
              <Icon name="linkedin" size={16} />
              LinkedIn
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface py-20 lg:py-28" aria-labelledby="about-what">
    <div class="container-x">
      <p class="section-label reveal"><span class="num">02</span>{c.what.label}</p>
      <h2 id="about-what" class="h2 reveal mt-6 max-w-[24ch]">{c.what.h2}</h2>
      <p class="lede reveal mt-6 max-w-[62ch]">{c.what.body}</p>
      <ul class="mt-12 grid gap-4 md:grid-cols-3">
        {
          services.map((s, i) => (
            <li class="reveal" style={`--d: ${i * 80}ms`}>
              <a href={servicePath(s, lang)} class="card spotlight group flex h-full flex-col justify-between gap-8 p-7">
                <span>
                  <span class="eyebrow block">{s[lang].name}</span>
                  <span class="mt-3 block font-display text-xl leading-snug font-semibold">{s[lang].h1}</span>
                </span>
                <span class="inline-flex items-center gap-2 font-semibold">
                  {c.what.explore} {s[lang].name}
                  <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-20 lg:py-28" aria-labelledby="about-for">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="section-label reveal"><span class="num">03</span>{c.forWhom.label}</p>
        <h2 id="about-for" class="h2 reveal mt-6">{c.forWhom.h2}</h2>
        <p class="lede reveal mt-6 max-w-[52ch]">{c.forWhom.body}</p>
      </div>
      <ul class="grid content-center gap-3">
        {
          c.forWhom.items.map((item, i) => (
            <li class="reveal flex items-start gap-4 rounded-2xl border border-line bg-paper-raised px-5 py-4 leading-snug" style={`--d: ${i * 60}ms`}>
              <Icon name="check" size={18} class="mt-0.5 shrink-0" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-line py-20 lg:py-28" aria-labelledby="about-where">
    <div class="container-x">
      <p class="section-label reveal"><span class="num">04</span>{c.where.label}</p>
      <h2 id="about-where" class="h2 reveal mt-6 max-w-[28ch]">{c.where.h2}</h2>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        {
          c.where.cards.map((card, i) => (
            <div class="card reveal flex flex-col p-7 sm:p-8" style={`--d: ${i * 80}ms`}>
              <h3 class="eyebrow">{card.title}</h3>
              <p class="mt-4 text-[1.05rem] leading-relaxed">{card.body}</p>
              {card.link && (
                <a href={westMichiganPath(lang)} class="link-arrow mt-6">
                  {card.link.label}
                  <Icon name="arrow" size={15} class="arrow" />
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-surface py-20 lg:py-28" aria-labelledby="about-results">
    <div class="container-x">
      <p class="section-label reveal"><span class="num">05</span>{c.results.label}</p>
      <h2 id="about-results" class="h2 reveal mt-6">{t.proof.h2}</h2>
      <div class="mt-12 grid gap-4 lg:grid-cols-3">
        {
          t.proof.cards.map((card, i) => (
            <figure class="card reveal flex flex-col p-7" style={`--d: ${i * 80}ms`}>
              <p class="eyebrow">{card.segment}</p>
              <div class="mt-4 flex flex-wrap items-end gap-x-6 gap-y-2">
                {card.figures.map((fig, fi) => (
                  <p
                    class:list={['font-display font-semibold tracking-tight tabular-nums leading-none', fi === 0 ? 'text-5xl' : 'text-3xl text-muted']}
                    data-countup
                    data-to={fig.to}
                    data-prefix={fig.prefix}
                    data-suffix={fig.suffix}
                  >
                    {show(fig)}
                  </p>
                ))}
              </div>
              <blockquote class="mt-5 border-t border-line pt-4 leading-relaxed">{card.statement}</blockquote>
            </figure>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-muted">{t.proof.note}</p>
      <h3 class="eyebrow mt-14">{c.standardsLabel}</h3>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          t.about.standards.map((line, i) => (
            <li class="reveal flex items-start gap-3 rounded-2xl border border-line bg-paper-raised px-5 py-4 leading-snug" style={`--d: ${i * 60}ms`}>
              <Icon name="check" size={18} class="mt-0.5 shrink-0" />
              {line}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-20 lg:py-28" aria-labelledby="about-faq">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="section-label reveal"><span class="num">06</span>{c.faq.label}</p>
        <h2 id="about-faq" class="h2 reveal mt-6">{c.faq.h2}</h2>
      </div>
      <div class="faq lg:col-span-8">
        {
          c.faq.items.map((item, i) => (
            <details class="reveal border-b border-line first:border-t" style={`--d: ${i * 60}ms`} name="about-faq" open={i === 0}>
              <summary class="flex items-center justify-between gap-6 py-6 text-left">
                <h3 class="font-display text-[clamp(1.15rem,1.7vw,1.4rem)] leading-snug font-semibold">{item.q}</h3>
                <span class="plus grid size-9 shrink-0 place-content-center rounded-full border border-line">
                  <Icon name="plus" size={16} />
                </span>
              </summary>
              <p class="max-w-[62ch] pb-7 leading-relaxed text-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pb-24 lg:pb-32" aria-labelledby="about-cta">
    <div class="container-x">
      <div class="band reveal relative overflow-hidden rounded-[32px] px-6 py-16 sm:px-12 lg:px-16 lg:py-20">
        <div class="grid-paper grid-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>
        <div class="relative max-w-3xl">
          <h2 id="about-cta" class="display text-[clamp(2.2rem,4.6vw,3.8rem)]">{c.cta.h2}</h2>
          <p class="lede mt-6 max-w-[52ch]">{c.cta.body}</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={schedulePath(lang)} class="btn btn-primary">
              {c.cta.button}
              <Icon name="arrow" size={18} class="arrow" />
            </a>
            <p class="text-sm text-muted">
              {c.cta.email} <a href={`mailto:${CONTACT_EMAIL}`} class="underline underline-offset-2 hover:text-on-band">{CONTACT_EMAIL}</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
