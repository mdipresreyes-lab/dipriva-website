---
import Icon from './Icon.astro';
import { copy, type Lang } from '../lib/copy';
import { homePath, schedulePath } from '../lib/site';
import { servicesHubPath } from '../lib/services';

interface Props {
  lang: Lang;
  alternate?: { en: string; es: string };
  onHome?: boolean;
}

const { lang, alternate, onHome = false } = Astro.props;
const t = copy[lang].nav;
const home = homePath(lang);
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const switchHref = alternate ? alternate[otherLang] : homePath(otherLang);

const links = [
  { label: t.services, href: onHome ? '#services' : servicesHubPath(lang) },
  { label: t.method, href: anchor('method') },
  { label: t.results, href: anchor('results') },
  { label: t.insights, href: lang === 'en' ? '/blog/' : anchor('insights') },
  { label: t.about, href: anchor('about') },
];
---

<header class="site-header sticky top-0 z-40">
  <div class="container-x flex h-[72px] items-center justify-between gap-6">
    <a href={home} class="group flex items-center gap-3">
      <span
        class="grid size-9 place-content-center rounded-[10px] bg-brand font-display text-[1.35rem] font-semibold leading-none text-on-brand transition-transform duration-300 group-hover:-rotate-6"
        aria-hidden="true">D</span
      >
      <span class="font-display text-[1.35rem] font-semibold tracking-[0.01em]">Dipriva</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-[0.95rem]">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="relative py-2 text-muted transition-colors hover:text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 hover:after:scale-x-100"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={switchHref}
        hreflang={otherLang}
        lang={otherLang}
        class="inline-flex h-10 items-center gap-1.5 rounded-full px-2.5 text-sm font-semibold text-muted transition-colors hover:bg-surface hover:text-ink sm:px-3"
        aria-label={`${t.switchLangShort} (${t.switchLang})`}
      >
        <Icon name="globe" size={17} />
        {t.switchLangShort}
      </a>
      <button
        type="button"
        id="theme-toggle"
        class="grid size-10 place-content-center rounded-full text-muted transition-colors hover:bg-surface hover:text-ink"
        aria-label={t.theme}
        title={t.theme}
      >
        <Icon name="moon" size={18} class="theme-icon-moon" />
        <Icon name="sun" size={18} class="theme-icon-sun hidden" />
      </button>
      <a href={schedulePath(lang)} class="btn btn-primary hidden md:inline-flex !min-h-10 !px-5 !py-2 text-sm">
        {t.cta}
      </a>
      <button
        type="button"
        popovertarget="mobile-nav"
        class="grid size-10 place-content-center rounded-full text-ink transition-colors hover:bg-surface lg:hidden"
        aria-label={t.menu}
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true"></div>
</header>

<div
  id="mobile-nav"
  popover
  class="sheet fixed inset-x-3 top-3 mx-auto max-w-md rounded-3xl border border-line bg-paper-raised p-6 shadow-2xl"
  aria-label={t.menu}
>
  <div class="flex items-center justify-between">
    <span class="eyebrow">{t.menu}</span>
    <button
      type="button"
      popovertarget="mobile-nav"
      popovertargetaction="hide"
      class="grid size-10 place-content-center rounded-full hover:bg-surface"
      aria-label={t.close}
    >
      <Icon name="close" size={20} />
    </button>
  </div>
  <ul class="mt-4 divide-y divide-line">
    {
      links.map((l) => (
        <li>
          <a href={l.href} class="mobile-nav-link flex items-center justify-between py-4 font-display text-2xl">
            {l.label}
            <Icon name="arrow" size={18} class="text-muted" />
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-6 flex flex-col gap-3">
    <a href={schedulePath(lang)} class="btn btn-primary w-full">{t.cta}</a>
    <a href={switchHref} hreflang={otherLang} lang={otherLang} class="btn btn-ghost w-full">
      <Icon name="globe" size={18} />
      {t.switchLang}
    </a>
  </div>
</div>

<style>
  :global([data-theme='dark'] .theme-icon-moon) {
    display: none;
  }
  :global([data-theme='dark'] .theme-icon-sun) {
    display: block;
  }
</style>
