---
import Icon from './Icon.astro';
import { copy, type Lang } from '../lib/copy';
import { schedulePath } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="mobile-cta fixed bottom-3 left-3 right-[76px] z-30 md:hidden">
  <a href={schedulePath} class="btn btn-primary w-full !min-h-14 shadow-xl">
    {copy[lang].mobileCta}
    <Icon name="arrow" size={18} class="arrow" />
  </a>
</div>
