---
import Icon from '../Icon.astro';
import { copy, type Lang } from '../../lib/copy';
import { LINKEDIN_FOUNDER } from '../../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].about;
// Line lengths for the redacted body of each sample page, so every page reads differently.
const bars = [
  [92, 78, 85, 60],
  [88, 70, 94, 52],
  [80, 90, 66, 74],
];
---

<section id="about" class="py-24 lg:py-32" aria-labelledby="about-title">
  <div class="container-x grid items-center gap-16 lg:grid-cols-12">
    <div class="reveal lg:col-span-6">
      <div class="docs relative mx-auto aspect-[5/4] w-full max-w-[560px]" aria-hidden="true">
        {
          t.documents.map((title, i) => (
            <div class="doc absolute top-1/2 left-1/2 w-[58%] rounded-[10px] border border-line bg-paper-raised p-[5%]" style={`--i: ${i}`}>
              <div class="flex items-center justify-between">
                <span class="grid size-6 place-content-center rounded-[6px] bg-brand font-display text-[0.7rem] font-semibold text-on-brand">D</span>
                <span class="text-[0.55rem] font-semibold tracking-[0.16em] text-muted uppercase">{t.sample}</span>
              </div>
              <p class="mt-[9%] font-display text-[clamp(0.85rem,1.6vw,1.15rem)] leading-tight font-semibold">{title}</p>
              <div class="mt-[8%] space-y-[5%]">
                {bars[i].map((w) => (
                  <span class="block h-[5px] rounded-full bg-surface" style={`width: ${w}%`} />
                ))}
              </div>
              <div class="mt-[9%] grid grid-cols-3 gap-[6%]">
                {[0, 1, 2].map((c) => (
                  <span class:list={['block h-7 rounded-[4px]', c === 0 ? 'bg-brand/80' : 'bg-surface']} />
                ))}
              </div>
              <div class="mt-[10%] flex items-center justify-between border-t border-line pt-[4%] text-[0.5rem] font-semibold tracking-[0.14em] text-muted uppercase">
                <span>{t.confidential}</span>
                <span>{t.sample}</span>
                <span>{t.page}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="lg:col-span-6">
      <p class="section-label reveal"><span class="num">09</span>{t.label}</p>
      <h2 id="about-title" class="h2 reveal mt-6" style="--d: 80ms">{t.h2}</h2>
      <p class="lede reveal mt-6 max-w-[56ch]" style="--d: 140ms">{t.body}</p>
      <ul class="reveal mt-8 grid gap-3 sm:grid-cols-2" style="--d: 180ms">
        {
          t.standards.map((line) => (
            <li class="flex items-start gap-3 rounded-2xl border border-line bg-paper-raised px-4 py-3 text-[0.95rem] leading-snug">
              <Icon name="check" size={16} class="mt-0.5 shrink-0" />
              {line}
            </li>
          ))
        }
      </ul>
      <div class="reveal mt-10 flex flex-wrap items-center gap-6" style="--d: 220ms">
        <a href={t.href} class="link-arrow">
          {t.cta}
          <Icon name="arrow" size={16} class="arrow" />
        </a>
        <a href={LINKEDIN_FOUNDER} rel="noopener" class="inline-flex items-center gap-2 text-sm font-semibold text-muted hover:text-ink">
          <Icon name="linkedin" size={18} />
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .doc {
    box-shadow: var(--shadow);
    transform: translate(-50%, -50%) translate(calc((var(--i) - 1) * 22%), calc((var(--i) - 1) * -6%))
      rotate(calc((var(--i) - 1) * 7deg));
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .doc:nth-child(3) {
    z-index: 2;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .docs:hover .doc {
      transform: translate(-50%, -50%) translate(calc((var(--i) - 1) * 34%), calc((var(--i) - 1) * -9%))
        rotate(calc((var(--i) - 1) * 10deg));
    }
  }
</style>
