---
import { copy, type Lang } from '../../lib/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].problem;
---

<section id="constraint" class="py-24 lg:py-32" aria-labelledby="constraint-title">
  <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start">
      <p class="section-label reveal"><span class="num">01</span>{t.label}</p>
      <h2 id="constraint-title" class="h2 reveal mt-6" style="--d: 80ms">{t.h2}</h2>
    </div>
    <div class="lg:col-span-7">
      <p class="lede reveal">{t.body}</p>
      <ol class="mt-12 space-y-4">
        {
          t.cards.map((card, i) => (
            <li class="card spotlight reveal flex gap-6 p-6 sm:p-8" style={`--d: ${i * 90}ms`}>
              <span class="font-display text-4xl leading-none font-semibold text-muted/60 tabular-nums" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="h3">{card.title}</h3>
                <p class="mt-2 leading-relaxed text-muted">{card.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="reveal mt-12 border-l-2 border-ink pl-6 font-display text-[clamp(1.35rem,2.2vw,1.75rem)] leading-snug italic">
        {t.close}
      </p>
    </div>
  </div>
</section>
