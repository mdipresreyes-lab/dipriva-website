---
import type { ServiceKey } from '../../lib/services';

interface Props {
  kind: ServiceKey;
  labels: { center: string; nodes: string[] };
}

const { kind, labels } = Astro.props;
---

<div class="service-visual relative mx-auto w-full max-w-[460px]" aria-hidden="true">
  <div class="grid-paper absolute inset-[4%] rounded-[28px] opacity-80 [mask-image:radial-gradient(circle,#000_50%,transparent_75%)]"></div>
  {
    kind === 'strategy' && (
      <svg viewBox="0 0 400 320" class="relative w-full">
        {/* One decision, three options, one path carried to the roadmap. */}
        {[70, 160, 250].map((y) => (
          <path class="lever-link" d={`M70 160 C 140 160, 140 ${y}, 210 ${y}`} fill="none" />
        ))}
        <path class="lever-link" d="M210 160 L 330 160" fill="none" />
        <path class="lever-pulse" d="M70 160 C 140 160, 140 160, 210 160 L 330 160" fill="none" pathLength="100" />
        <circle cx="70" cy="160" r="30" style="fill: var(--brand)" />
        <text x="70" y="165" text-anchor="middle" class="svc-label-inv">{labels.nodes[0]}</text>
        {[70, 160, 250].map((y, i) => (
          <g class="lever-node">
            <circle cx="210" cy={y} r={i === 1 ? 26 : 22} style={i === 1 ? 'stroke: var(--ink); stroke-width: 2' : ''} />
          </g>
        ))}
        <circle class="hub-ring" cx="330" cy="160" r="40" style="transform-origin: 330px 160px" />
        <circle cx="330" cy="160" r="32" style="fill: var(--brand)" />
        <text x="330" y="157" text-anchor="middle" class="svc-label-inv svc-strong">90</text>
        <text x="330" y="172" text-anchor="middle" class="svc-label-inv">{labels.center}</text>
      </svg>
    )
  }
  {
    kind === 'ops' && (
      <svg viewBox="0 0 400 320" class="relative w-full">
        {/* Work leaves the founder's desk and lands with named owners. */}
        {[
          [80, 70],
          [320, 70],
          [80, 250],
          [320, 250],
        ].map(([x, y], i) => (
          <g>
            <line class="lever-link" x1="200" y1="160" x2={x} y2={y} />
            <line class="lever-pulse" x1="200" y1="160" x2={x} y2={y} pathLength="100" style={`--d: ${(i * 0.8).toFixed(1)}s`} />
          </g>
        ))}
        <circle class="hub-ring" cx="200" cy="160" r="52" />
        <circle cx="200" cy="160" r="42" style="fill: var(--brand)" />
        <text x="200" y="165" text-anchor="middle" class="svc-label-inv svc-strong">{labels.center}</text>
        {[
          [80, 70],
          [320, 70],
          [80, 250],
          [320, 250],
        ].map(([x, y], i) => (
          <g class="lever-node">
            <circle cx={x} cy={y} r="30" />
            <text x={x} y={y + 4} text-anchor="middle">
              {labels.nodes[i]}
            </text>
          </g>
        ))}
      </svg>
    )
  }
  {
    kind === 'ai' && (
      <svg viewBox="0 0 400 320" class="relative w-full">
        {/* A task moves through gates; each gate is a check before it ships. */}
        <line class="lever-link" x1="40" y1="160" x2="360" y2="160" />
        <line class="lever-pulse" x1="40" y1="160" x2="360" y2="160" pathLength="100" />
        {[40, 120, 200, 280, 360].map((x, i) => (
          <g class="lever-node">
            <circle cx={x} cy="160" r={i === 4 ? 26 : 20} style={i === 4 ? 'fill: var(--brand); stroke: var(--brand)' : ''} />
            {i < 4 && <path d={`M${x - 6} 160l4 4 8-8`} fill="none" style="stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round" />}
            <text x={x} y={i % 2 ? 120 : 212} text-anchor="middle">
              {labels.nodes[i]}
            </text>
          </g>
        ))}
        <path d="M352 160l5 5 10-10" fill="none" style="stroke: var(--on-brand); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round" />
      </svg>
    )
  }
</div>

<style>
  .service-visual :global(.svc-label-inv) {
    fill: var(--on-brand);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
  }
  .service-visual :global(.svc-strong) {
    font-family: var(--font-playfair);
    font-size: 17px;
  }
</style>
